# Admin panel — required to sign in at /admin
ADMIN_PASSWORD=

# Optional: separate secret for signing admin session cookies.
# Falls back to ADMIN_PASSWORD when unset.
ADMIN_SESSION_SECRET=

# Contact form (https://resend.com)
RESEND_API_KEY=


portfolio_KV_REST_API_READ_ONLY_TOKEN="<upstash_read_only_token>"
portfolio_KV_REST_API_TOKEN="<upstash_read_write_token>"
portfolio_KV_REST_API_URL="https://<upstash_domain>.upstash.io"
portfolio_KV_URL="rediss://default:<upstash_read_write_token>@<upstash_domain>.upstash.io:6379"
portfolio_REDIS_URL="rediss://default:<upstash_read_write_token>@<upstash_domain>.upstash.io:6379"